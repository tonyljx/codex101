---
import LandingPage from '../../components/LandingPage.astro';
import { locales, type Locale } from '../../lib/site';

export function getStaticPaths() {
  return locales.filter((locale) => locale !== 'zh').map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
---

<LandingPage locale={locale} currentPath={Astro.url.pathname} />
